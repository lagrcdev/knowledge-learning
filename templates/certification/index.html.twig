{% extends 'base.html.twig' %}

{% block title %}Mes certifications | Knowledge Learning{% endblock %}

{% block body %}
    <h1>Mes certifications</h1>

    {% if certifications|length == 0 %}
        <p>Vous n'avez obtenu aucune certification pour l'instant.</p>
    {% else %}
        <ul>
            {% for certification in certifications %}
                <li>{{ certification.cursus.name }} - validée le {{ certification.validatedAt|date('d/m/Y') }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
