{% extends 'base.html.twig' %}

{% block title %}Achats | Administration{% endblock %}

{% block body %}
    <h1>Achats</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Type</th>
                <th>Article</th>
                <th>Montant</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for purchase in purchases %}
                <tr>
                    <td>{{ purchase.user.email }}</td>
                    <td>{{ purchase.type }}</td>
                    <td>{{ purchase.cursus ? purchase.cursus.name : purchase.lesson.title }}</td>
                    <td>{{ purchase.amount }} €</td>
                    <td>{{ purchase.purchasedAt|date('Y-m-d H:i') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
